{
  "permissions": {
    "allow": ["Bash(python3 plugins/video-factory/scripts/*)", "Bash(ffmpeg *)", "Bash(ffprobe *)", "Read", "Write", "Edit", "WebSearch", "Skill", "Agent"],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PostToolUse": [{"matcher": "Write|Edit", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/plugins/video-factory/scripts/hook_validate.py\""}]}],
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/plugins/video-factory/scripts/hook_guard.py\""}]}]
  }
}
